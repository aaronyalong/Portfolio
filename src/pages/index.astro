---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO(Aaron): choose the 3 featured projects; replaced by content collection in Phase 3.
const featured = [1, 2, 3];
---

<BaseLayout>
	<section class="intro">
		<h1>Aaron Yalong</h1>
		<p class="pitch">
			Software engineer focused on LLM application engineering: agentic systems, RAG pipelines,
			MCP servers.
		</p>
	</section>

	<section aria-labelledby="featured-heading">
		<h2 id="featured-heading">Featured projects</h2>
		<ul class="cards">
			{
				featured.map((n) => (
					<li class="card">
						<h3>Featured project {n}</h3>
						<p class="todo">TODO: project name, one-line summary, link to case study</p>
					</li>
				))
			}
		</ul>
		<p><a href="/projects/">All projects →</a></p>
	</section>

	<section aria-labelledby="more-heading">
		<h2 id="more-heading">More</h2>
		<ul class="links">
			<li><a href="/experience/">Experience &amp; education</a></li>
			<li><a href="https://github.com/aaronyalong">GitHub</a></li>
			<li class="todo">TODO: resume PDF, LinkedIn, email (Phase 5)</li>
		</ul>
	</section>
</BaseLayout>

<style>
	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.pitch {
		margin-top: var(--space-3);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.cards {
		display: grid;
		gap: var(--space-4);
		padding: 0;
		margin-bottom: var(--space-4);
		list-style: none;
	}

	.card {
		padding: var(--space-4) var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.card h3 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}

	.links {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-6);
	}
</style>
