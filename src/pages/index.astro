---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showcase from '../components/Showcase.astro';
import Interests from '../components/Interests.astro';
import HeroLinks from '../components/HeroLinks.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getEducation, getExperience, getProjects, primaryCurrent } from '../lib/content';
import { CONTACT } from '../lib/site';

const FEATURED_COUNT = 3;
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, FEATURED_COUNT);
// Every project appears once: featured ones as showcase tiles, the rest as cards below.
const more = projects.filter((p) => !featured.includes(p));

const jobs = await getExperience();
const degrees = await getEducation();

// "Now" line: the primary current role and degree (the ones with the accent dot below).
const now = [primaryCurrent(jobs), primaryCurrent(degrees)]
	.filter((item) => item !== undefined)
	.map((item) => `${item.data.title} at ${item.data.org}`);
---

<BaseLayout>
	<div class="graph">
	<section class="hero node" data-spotlight=".hero-bg">
		<div class="hero-bg" aria-hidden="true"></div>
		<img
			class="portrait rise"
			src="/images/headshot.webp"
			alt="Headshot of Aaron Yalong"
			width="256"
			height="256"
			fetchpriority="high"
		/>
		<div class="hero-text">
			<h1 class="rise">Aaron Yalong</h1>
			<p class="pitch rise" style="--rise-step: 1">
				Software engineer focused on LLM application engineering: agentic systems, RAG
				pipelines, MCP servers.
			</p>
			<ul class="now rise" style="--rise-step: 2" aria-label="Currently">
				{now.map((item) => <li>{item}</li>)}
			</ul>
			<div class="hero-links rise" style="--rise-step: 3">
				<HeroLinks />
			</div>
		</div>
	</section>

	<section id="about" aria-labelledby="about-heading" class="node rise" style="--rise-step: 4">
		<h2 id="about-heading">About</h2>
		<p class="bio">
			I'm a software engineer at Intuitive Machines, where I build an agentic AI desktop
			application on Claude for aerospace engineering teams, and I'm working toward an M.S. in
			Artificial Intelligence at San José State. I'm drawn to LLM systems that show their work:
			retrieval that cites its sources, agents that use real tools, and evaluations that check
			whether any of it actually helps. Before AI, I studied computer science and engineering at
			UC Irvine, building compilers, processors, and embedded systems.
		</p>
		<div class="outdoors">
			<div class="backdrop" aria-hidden="true">
				<img src="/images/mount-shasta.webp" alt="" width="2400" height="1600" loading="lazy" />
			</div>
			<h3 id="interests-heading">Outside of work</h3>
			<Interests />
		</div>
	</section>

	<section id="experience" aria-labelledby="experience-heading" class="node">
		<h2 id="experience-heading">Experience</h2>
		<Timeline items={jobs} />
	</section>

	<section id="education" aria-labelledby="education-heading" class="node">
		<h2 id="education-heading">Education</h2>
		<Timeline items={degrees} />
	</section>

	<section id="projects" aria-labelledby="projects-heading" class="node">
		<h2 id="projects-heading">Projects</h2>
		<p class="lede">
			Case studies: the problem, the architecture, key decisions, results and limitations.
		</p>
		{
			featured.length < FEATURED_COUNT && (
				<p class="todo">
					TODO: set `featured: true` on {FEATURED_COUNT} projects ({featured.length} set)
				</p>
			)
		}
		{featured.length > 0 && <Showcase projects={featured} />}
		{
			more.length > 0 && (
				<>
					<h3 class="more-heading">More projects</h3>
					<ul class="cards">
						{more.map((project) => (
							<li>
								<ProjectCard project={project} as="h4" />
							</li>
						))}
					</ul>
				</>
			)
		}
	</section>

	<section id="contact" aria-labelledby="contact-heading" class="node">
		<h2 id="contact-heading">Contact</h2>
		<div class="contact-panel">
			<div>
				<p class="contact-line">
					Open to conversations about LLM applications, agentic systems, and evaluation. The
					fastest way to reach me is email.
				</p>
				<p class="email">
					<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
				</p>
			</div>
			<HeroLinks />
		</div>
	</section>
	</div>
</BaseLayout>

<style>
	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.pitch {
		max-width: var(--prose-width);
		margin-top: var(--space-3);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	/*
	 * Graph rail: a glowing line down the page linking every section, with a node beside each
	 * heading. --rail is the line's x offset from the content's left edge: in the left margin on
	 * wide screens, inside a small left padding on narrow ones. Interests.astro reads it too.
	 */
	.graph {
		--rail: -1.1rem;
		--graph-pad: 1.6rem;
		--dot: 12px;
		--heading-mid: 1.1rem; /* vertical middle of an h2's first line */
		padding-left: var(--graph-pad);
	}

	/* Rail in the left margin only once the margin is wide enough to hold it: the container
	   (content + gutters) plus about 2.5rem each side. Below that, it sits in the padding. */
	@media (min-width: 80rem) {
		.graph {
			--rail: -2.25rem;
			--graph-pad: 0px;
		}
	}

	.node {
		position: relative;
		--node-top: calc(var(--heading-mid) - var(--dot) / 2);
		view-timeline: --section block;
	}

	/*
	 * Hero: one portrait image, placed by grid areas. Narrow: portrait above the text, and the
	 * rail node beside the portrait. From 900px: text left, larger portrait right, and the node
	 * beside the name's first line (the text column is top-aligned, so that line's position is
	 * known: top padding + half the h1's line box).
	 */
	.hero {
		display: grid;
		grid-template-areas: 'portrait' 'text';
		gap: var(--space-6);
	}

	.hero.node {
		--portrait: 5.5rem;
		--node-top: calc(var(--space-8) + var(--portrait) / 2 - var(--dot) / 2);
	}

	.hero-text {
		grid-area: text;
		min-width: 0;
	}

	.portrait {
		grid-area: portrait;
		width: var(--portrait);
		height: var(--portrait);
		border-radius: 50%;
		object-fit: cover;
		box-shadow:
			0 0 0 3px var(--color-bg),
			0 0 0 5px color-mix(in srgb, var(--color-accent) 65%, transparent),
			0 0 28px color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	@media (min-width: 56.25rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) var(--portrait);
			grid-template-areas: 'text portrait';
			align-items: start;
			column-gap: var(--space-12);
		}

		.hero.node {
			/* 240px for now: the source is 256px. Raise to ~18rem with the 800px headshot. */
			--portrait: 15rem;
			--h1-line: calc(3.5rem * 1.25);
			--node-top: calc(var(--space-8) + var(--h1-line) / 2 - var(--dot) / 2);
		}

		.portrait {
			align-self: center;
			box-shadow:
				0 0 0 4px var(--color-bg),
				0 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent),
				0 0 48px color-mix(in srgb, var(--color-accent) 40%, transparent);
		}
	}

	/* About: the bio, then "Outside of work" over Mount Shasta as a faded full-width backdrop
	   with gentle parallax. The parallax runs on the section's --section view timeline. */
	.bio {
		max-width: var(--prose-width);
		font-size: var(--text-lg);
	}

	.outdoors {
		position: relative;
		isolation: isolate;
		margin-top: var(--space-8);
		padding-bottom: var(--space-8);
	}

	.outdoors h3 {
		margin-bottom: var(--space-4);
	}

	.backdrop {
		position: absolute;
		z-index: -1;
		top: calc(-1 * var(--space-12));
		bottom: calc(-1 * var(--space-8));
		left: calc(50% - var(--graph-pad, 0px) / 2);
		width: 100vw;
		transform: translateX(-50%);
		overflow: hidden;
		opacity: 0.6;
		mask-image: linear-gradient(to bottom, transparent, black 22%, black 72%, transparent);
	}

	.backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		filter: saturate(1.15);
		transform: scale(1.12);
	}

	@media (prefers-color-scheme: light) {
		.backdrop {
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Longhands only; see the note in Interests.astro. */
			.backdrop img {
				animation-name: parallax;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --section;
				animation-range: cover 0% cover 100%;
			}
		}
	}

	@keyframes parallax {
		from {
			transform: translateY(-7%) scale(1.12);
		}
		to {
			transform: translateY(7%) scale(1.12);
		}
	}

	.node::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: var(--node-top);
		left: calc(var(--rail) - var(--dot) / 2);
		width: var(--dot);
		height: var(--dot);
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-accent) 22%, transparent),
			0 0 18px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	/* Segment from this node down to the next section's node (the last section: see below). */
	.node::after {
		content: '';
		position: absolute;
		top: calc(var(--node-top) + var(--dot) + 4px);
		bottom: calc(-1 * (var(--space-12) + var(--heading-mid) - var(--dot) / 2 - 4px));
		left: calc(var(--rail) - 1px);
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			to bottom,
			var(--color-accent),
			color-mix(in srgb, var(--color-accent) 35%, transparent)
		);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transform-origin: top;
	}

	/* The rail ends at the last section's node. */
	.node:last-child::after {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Hero: node and first segment draw on page load. */
		.hero.node::before {
			animation: pop 0.45s 0.15s ease-out both;
		}

		.hero.node::after {
			animation: grow-y 1.2s 0.45s cubic-bezier(0.3, 0.6, 0.2, 1) both;
		}

		/* Every later section: node pops, then its segment draws, as it scrolls in. */
		@supports (animation-timeline: view()) {
			/* Longhands only; see the note in Interests.astro. */
			.node:not(.hero)::before,
			.node:not(.hero)::after {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --section;
			}

			.node:not(.hero)::before {
				animation-name: pop;
				animation-range: entry 0% entry 15%;
			}

			.node:not(.hero)::after {
				animation-name: grow-y;
				animation-range: entry 10% cover 50%;
			}
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0);
		}
	}

	@keyframes grow-y {
		from {
			transform: scaleY(0);
		}
	}

	/* "Now" line: current role(s) and degree, as small pills with a live-status dot. */
	.now {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
	}

	.now li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 80%, transparent);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		backdrop-filter: blur(6px);
	}

	.now li::before {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	/* Hero: dot grid + two drifting accent glows, full window width, fading out downward. */
	.hero {
		position: relative;
		isolation: isolate;
		padding-block: var(--space-8) var(--space-12);
	}

	.hero h1 {
		font-size: clamp(var(--text-3xl), 7vw, 3.5rem);
		letter-spacing: -0.02em;
	}

	.hero-bg {
		position: absolute;
		z-index: -1;
		/* From the header's bottom edge (main's top padding) to below the pitch. */
		top: calc(-1 * var(--space-12));
		bottom: calc(-1 * var(--space-8));
		/* Centred on the page, not on the hero, which the graph's left padding shifts right. */
		left: calc(50% - var(--graph-pad, 0px) / 2);
		width: 100vw;
		transform: translateX(-50%);
		overflow: hidden; /* keep the glows inside */
		background-image: radial-gradient(
			circle at 1px 1px,
			color-mix(in srgb, var(--color-text) 20%, transparent) 1px,
			transparent 0
		);
		background-size: 22px 22px;
		mask-image: linear-gradient(to bottom, black 35%, transparent);
	}

	/* Cursor spotlight (src/scripts/spotlight.ts writes --mx / --my here): under the dots. */
	@media (hover: hover) and (pointer: fine) {
		.hero-bg {
			background-image:
				radial-gradient(
					circle at 1px 1px,
					color-mix(in srgb, var(--color-text) 20%, transparent) 1px,
					transparent 0
				),
				radial-gradient(
					circle 460px at var(--mx, -1000px) var(--my, -1000px),
					color-mix(in srgb, var(--color-accent) 18%, transparent),
					transparent 70%
				);
			background-size:
				22px 22px,
				100% 100%;
		}
	}

	.hero-bg::before,
	.hero-bg::after {
		content: '';
		position: absolute;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--color-accent) var(--glow-mix), transparent),
			transparent
		);
	}

	/* Sizes and offsets shrink with the window, so phones still see both glows. */
	.hero-bg::before {
		top: -140px;
		left: calc(50% - min(460px, 75vw));
		width: min(520px, 110vw);
	}

	.hero-bg::after {
		top: 20px;
		left: calc(50% + min(20px, 5vw));
		width: min(400px, 80vw);
		opacity: 0.75;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-bg::before {
			animation: drift 18s ease-in-out infinite alternate;
		}

		.hero-bg::after {
			animation: drift 22s ease-in-out infinite alternate-reverse;
		}
	}

	@keyframes drift {
		to {
			transform: translate(60px, 30px) scale(1.1);
		}
	}

	.hero-links {
		margin-top: var(--space-6);
	}

	/* Projects */
	.lede {
		margin-bottom: var(--space-6);
		color: var(--color-text-muted);
	}

	.more-heading {
		margin-block: var(--space-8) var(--space-4);
		font-size: var(--text-lg);
	}

	.cards {
		display: grid;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	/* Contact: a short line and the email on the left, the link buttons on the right. */
	.contact-panel {
		display: grid;
		align-items: center;
		gap: var(--space-6);
		/* Tight on phones so Resume and the three icon buttons fit on one row. */
		padding: var(--space-6) var(--space-4);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: calc(var(--radius) * 2);
	}

	@media (min-width: 48rem) {
		.contact-panel {
			grid-template-columns: minmax(0, 1fr) auto;
			column-gap: var(--space-12);
			padding: var(--space-8);
		}
	}

	.contact-line {
		max-width: var(--prose-width);
		font-size: var(--text-lg);
	}

	.email {
		margin-top: var(--space-2);
		font-weight: 600;
	}
</style>
