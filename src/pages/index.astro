---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';

const FEATURED_COUNT = 3;
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, FEATURED_COUNT);
---

<BaseLayout>
	<section class="intro">
		<h1>Aaron Yalong</h1>
		<p class="pitch">
			Software engineer focused on LLM application engineering: agentic systems, RAG pipelines,
			MCP servers.
		</p>
	</section>

	<section aria-labelledby="featured-heading">
		<h2 id="featured-heading">Featured projects</h2>
		{
			featured.length < FEATURED_COUNT && (
				<p class="todo">
					TODO: set `featured: true` on {FEATURED_COUNT} projects ({featured.length} set)
				</p>
			)
		}
		{
			featured.length > 0 && (
				<ul class="cards">
					{featured.map((project) => (
						<li>
							<ProjectCard project={project} />
						</li>
					))}
				</ul>
			)
		}
		<p class="all"><a href="/projects/">All projects →</a></p>
	</section>

	<section aria-labelledby="more-heading">
		<h2 id="more-heading">More</h2>
		<ul class="links">
			<li><a href="/experience/">Experience &amp; education</a></li>
			<li><a href="https://github.com/aaronyalong">GitHub</a></li>
			<li class="todo">TODO: resume PDF, LinkedIn, email (Phase 5)</li>
		</ul>
	</section>
</BaseLayout>

<style>
	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.pitch {
		margin-top: var(--space-3);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.cards {
		display: grid;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.all {
		margin-top: var(--space-4);
	}

	.links {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-6);
	}
</style>
