---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showcase from '../components/Showcase.astro';
import Interests from '../components/Interests.astro';
import HeroLinks from '../components/HeroLinks.astro';
import { getExperience, getProjects } from '../lib/content';

const FEATURED_COUNT = 3;
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, FEATURED_COUNT);

// "Now" line: current roles come from experience entries that end in `present`.
const current = (await getExperience())
	.filter((job) => job.data.end === 'present')
	.map((job) => `${job.data.role} at ${job.data.company}`);
const now = [...current, 'M.S. Artificial Intelligence at San José State University'];
---

<BaseLayout>
	<div class="graph">
	<section class="hero node" data-spotlight=".hero-bg">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="identity rise">
			<img
				class="avatar"
				src="/images/headshot.webp"
				alt="Headshot of Aaron Yalong"
				width="256"
				height="256"
				fetchpriority="high"
			/>
			<h1>Aaron Yalong</h1>
		</div>
		<p class="pitch rise" style="--rise-step: 1">
			Software engineer focused on LLM application engineering: agentic systems, RAG pipelines,
			MCP servers.
		</p>
		<ul class="now rise" style="--rise-step: 2" aria-label="Currently">
			{now.map((item) => <li>{item}</li>)}
		</ul>
		<div class="hero-links rise" style="--rise-step: 3">
			<HeroLinks />
		</div>
	</section>

	<section aria-labelledby="featured-heading" class="node rise" style="--rise-step: 4">
		<h2 id="featured-heading">Selected work</h2>
		{
			featured.length < FEATURED_COUNT && (
				<p class="todo">
					TODO: set `featured: true` on {FEATURED_COUNT} projects ({featured.length} set)
				</p>
			)
		}
		{featured.length > 0 && <Showcase projects={featured} />}
		<p class="all"><a href="/projects/">All projects →</a></p>
	</section>

	<section aria-labelledby="interests-heading" class="node outdoors">
		<div class="backdrop" aria-hidden="true">
			<img src="/images/mount-shasta.webp" alt="" width="2400" height="1600" loading="lazy" />
		</div>
		<h2 id="interests-heading">Outside of work</h2>
		<Interests />
	</section>
	</div>
</BaseLayout>

<style>
	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.pitch {
		margin-top: var(--space-3);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	/*
	 * Graph rail: a glowing line down the page linking every section, with a node beside each
	 * heading. --rail is the line's x offset from the content's left edge: in the left margin on
	 * wide screens, inside a small left padding on narrow ones. Interests.astro reads it too.
	 */
	.graph {
		--rail: -1.1rem;
		--graph-pad: 1.6rem;
		--dot: 12px;
		--heading-mid: 1.1rem; /* vertical middle of an h2's first line */
		padding-left: var(--graph-pad);
	}

	@media (min-width: 52rem) {
		.graph {
			--rail: -2.25rem;
			--graph-pad: 0px;
		}
	}

	.node {
		position: relative;
		--node-top: calc(var(--heading-mid) - var(--dot) / 2);
		view-timeline: --section block;
	}

	/* The hero's node sits beside the avatar + name row (the avatar is the taller of the two). */
	.hero.node {
		--avatar: 4rem;
		--node-top: calc(var(--space-8) + var(--avatar) / 2 - var(--dot) / 2);
	}

	@media (min-width: 40rem) {
		.hero.node {
			--avatar: 5.5rem;
		}
	}

	.identity {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	/* Small on purpose: the source photo is soft. */
	.avatar {
		flex: none;
		width: var(--avatar);
		height: var(--avatar);
		border-radius: 50%;
		object-fit: cover;
		box-shadow:
			0 0 0 3px var(--color-bg),
			0 0 0 5px color-mix(in srgb, var(--color-accent) 65%, transparent),
			0 0 28px color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	/* "Outside of work": Mount Shasta as a faded full-width backdrop with gentle parallax. */
	.outdoors {
		isolation: isolate;
		/* Room below the last branch so it can scroll fully into view (it ends the page). */
		padding-bottom: var(--space-16);
	}

	.backdrop {
		position: absolute;
		z-index: -1;
		top: calc(-1 * var(--space-12));
		bottom: calc(-1 * var(--space-8));
		left: calc(50% - var(--graph-pad, 0px) / 2);
		width: 100vw;
		transform: translateX(-50%);
		overflow: hidden;
		opacity: 0.6;
		mask-image: linear-gradient(to bottom, transparent, black 22%, black 72%, transparent);
	}

	.backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		filter: saturate(1.15);
		transform: scale(1.12);
	}

	@media (prefers-color-scheme: light) {
		.backdrop {
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Longhands only; see the note in Interests.astro. */
			.backdrop img {
				animation-name: parallax;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --section;
				animation-range: cover 0% cover 100%;
			}
		}
	}

	@keyframes parallax {
		from {
			transform: translateY(-7%) scale(1.12);
		}
		to {
			transform: translateY(7%) scale(1.12);
		}
	}

	.node::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: var(--node-top);
		left: calc(var(--rail) - var(--dot) / 2);
		width: var(--dot);
		height: var(--dot);
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-accent) 22%, transparent),
			0 0 18px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	/* Segment from this node down to the next section's node (the last section: see below). */
	.node::after {
		content: '';
		position: absolute;
		top: calc(var(--node-top) + var(--dot) + 4px);
		bottom: calc(-1 * (var(--space-12) + var(--heading-mid) - var(--dot) / 2 - 4px));
		left: calc(var(--rail) - 1px);
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			to bottom,
			var(--color-accent),
			color-mix(in srgb, var(--color-accent) 35%, transparent)
		);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transform-origin: top;
	}

	/* The last section's segment ends at its last branch (the middle of the last interest pill,
	   which sits above the section's bottom padding), instead of running on to a next node. */
	.node:last-child::after {
		bottom: calc(var(--space-16) + 1.9rem);
		background: var(--color-accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Hero: node and first segment draw on page load. */
		.hero.node::before {
			animation: pop 0.45s 0.15s ease-out both;
		}

		.hero.node::after {
			animation: grow-y 1.2s 0.45s cubic-bezier(0.3, 0.6, 0.2, 1) both;
		}

		/* Every later section: node pops, then its segment draws, as it scrolls in. */
		@supports (animation-timeline: view()) {
			/* Longhands only; see the note in Interests.astro. */
			.node:not(.hero)::before,
			.node:not(.hero)::after {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --section;
			}

			.node:not(.hero)::before {
				animation-name: pop;
				animation-range: entry 0% entry 15%;
			}

			.node:not(.hero)::after {
				animation-name: grow-y;
				animation-range: entry 10% cover 50%;
			}

			/* The last section ends the page, so it may never reach cover 50%: finish drawing
			   by the time the whole section has entered the viewport instead. */
			.node:not(.hero):last-child::after {
				animation-range: entry 0% entry 100%;
			}
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0);
		}
	}

	@keyframes grow-y {
		from {
			transform: scaleY(0);
		}
	}

	/* "Now" line: current role(s) and degree, as small pills with a live-status dot. */
	.now {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
	}

	.now li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 80%, transparent);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		backdrop-filter: blur(6px);
	}

	.now li::before {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	/* Hero: dot grid + two drifting accent glows, full window width, fading out downward. */
	.hero {
		position: relative;
		isolation: isolate;
		padding-block: var(--space-8) var(--space-12);
	}

	.hero h1 {
		font-size: clamp(var(--text-3xl), 7vw, 3.5rem);
		letter-spacing: -0.02em;
	}

	.hero-bg {
		position: absolute;
		z-index: -1;
		/* From the header's bottom edge (main's top padding) to below the pitch. */
		top: calc(-1 * var(--space-12));
		bottom: calc(-1 * var(--space-8));
		/* Centred on the page, not on the hero, which the graph's left padding shifts right. */
		left: calc(50% - var(--graph-pad, 0px) / 2);
		width: 100vw;
		transform: translateX(-50%);
		overflow: hidden; /* keep the glows inside */
		background-image: radial-gradient(
			circle at 1px 1px,
			color-mix(in srgb, var(--color-text) 20%, transparent) 1px,
			transparent 0
		);
		background-size: 22px 22px;
		mask-image: linear-gradient(to bottom, black 35%, transparent);
	}

	/* Cursor spotlight (src/scripts/spotlight.ts writes --mx / --my here): under the dots. */
	@media (hover: hover) and (pointer: fine) {
		.hero-bg {
			background-image:
				radial-gradient(
					circle at 1px 1px,
					color-mix(in srgb, var(--color-text) 20%, transparent) 1px,
					transparent 0
				),
				radial-gradient(
					circle 460px at var(--mx, -1000px) var(--my, -1000px),
					color-mix(in srgb, var(--color-accent) 18%, transparent),
					transparent 70%
				);
			background-size:
				22px 22px,
				100% 100%;
		}
	}

	.hero-bg::before,
	.hero-bg::after {
		content: '';
		position: absolute;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--color-accent) var(--glow-mix), transparent),
			transparent
		);
	}

	/* Sizes and offsets shrink with the window, so phones still see both glows. */
	.hero-bg::before {
		top: -140px;
		left: calc(50% - min(460px, 75vw));
		width: min(520px, 110vw);
	}

	.hero-bg::after {
		top: 20px;
		left: calc(50% + min(20px, 5vw));
		width: min(400px, 80vw);
		opacity: 0.75;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-bg::before {
			animation: drift 18s ease-in-out infinite alternate;
		}

		.hero-bg::after {
			animation: drift 22s ease-in-out infinite alternate-reverse;
		}
	}

	@keyframes drift {
		to {
			transform: translate(60px, 30px) scale(1.1);
		}
	}

	.all {
		margin-top: var(--space-4);
	}

	.hero-links {
		margin-top: var(--space-6);
	}
</style>
