---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatRange, getExperience, isTodo } from '../lib/content';

const jobs = await Promise.all(
	(await getExperience()).map(async (job) => ({
		job,
		range: formatRange(job.data.start, job.data.end),
		Content: (await render(job)).Content,
	})),
);
---

<BaseLayout title="Experience" description="Work experience and education of Aaron Yalong.">
	<h1>Experience &amp; education</h1>

	<section aria-labelledby="experience-heading">
		<h2 id="experience-heading">Experience</h2>
		<ol class="jobs">
			{
				jobs.map(({ job, range, Content }) => (
					<li class="job">
						<h3>
							<span class:list={{ todo: isTodo(job.data.role) }}>{job.data.role}</span>{' '}
							<span class="company">· {job.data.company}</span>
						</h3>
						<p class="dates">
							{range.start ?? <span class="todo">TODO: start</span>}
							{' – '}
							{range.end ?? <span class="todo">TODO: end</span>}
							{job.data.partTime && ' · Part-time'}
						</p>
						<div class="body">
							<Content />
						</div>
						{job.data.stack.length > 0 && (
							<p class="stack">{job.data.stack.join(' · ')}</p>
						)}
					</li>
				))
			}
		</ol>
	</section>

	<section aria-labelledby="education-heading">
		<h2 id="education-heading">Education</h2>
		<ol class="jobs">
			<li class="job">
				<h3>
					M.S. Artificial Intelligence{' '}
					<span class="company">· San José State University</span>
				</h3>
				<p class="dates">Expected Dec 2027</p>
			</li>
			<li class="job">
				<h3>
					B.S. Computer Science &amp; Engineering{' '}
					<span class="company">· University of California, Irvine</span>
				</h3>
				<p class="dates">2024</p>
				<p class="body">GPA 3.8 · Cum Laude</p>
			</li>
		</ol>
	</section>
</BaseLayout>

<style>
	h1 {
		margin-bottom: var(--space-8);
	}

	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.jobs {
		display: grid;
		gap: var(--space-8);
		padding: 0;
		list-style: none;
	}

	.job h3 {
		font-size: var(--text-lg);
	}

	.company {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	.dates,
	.stack {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.stack {
		font-family: var(--font-mono);
	}

	.body {
		margin-block: var(--space-2);
	}
</style>
