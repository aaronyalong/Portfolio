---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import ResumeButton from '../components/ResumeButton.astro';
import { getEducation, getExperience } from '../lib/content';

const jobs = await getExperience();
const degrees = await getEducation();
---

<BaseLayout title="Experience" description="Work experience and education of Aaron Yalong.">
	<header class="page-head">
		<h1>Experience &amp; education</h1>
		<ResumeButton label="Download résumé" download />
	</header>

	<section aria-labelledby="experience-heading">
		<h2 id="experience-heading">Experience</h2>
		<Timeline items={jobs} />
	</section>

	<section aria-labelledby="education-heading">
		<h2 id="education-heading">Education</h2>
		<Timeline items={degrees} />
	</section>
</BaseLayout>

<style>
	/* Title with the resume button beside it; the button wraps below on narrow screens. */
	.page-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4) var(--space-6);
		margin-bottom: var(--space-8);
	}

	section + section {
		margin-top: var(--space-12);
	}

	h2 {
		margin-bottom: var(--space-6);
	}
</style>
