---
/**
 * Hero link row: a primary Resume button plus round icon buttons for GitHub, LinkedIn and
 * email. Icons are inline SVG in currentColor; every button has an accessible label.
 */
import { CONTACT } from '../lib/site';

const SVG = (body: string, filled = false) =>
	`<svg viewBox="0 0 24 24" ${filled ? 'fill="currentColor"' : 'fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"'} aria-hidden="true">${body}</svg>`;

const icons = [
	{
		label: 'GitHub',
		href: CONTACT.github,
		svg: SVG(
			'<path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>',
			true,
		),
	},
	{
		label: 'LinkedIn',
		href: CONTACT.linkedin,
		svg: SVG(
			'<path fill-rule="evenodd" d="M4.5 2h15A2.5 2.5 0 0 1 22 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 19.5v-15A2.5 2.5 0 0 1 4.5 2zM7 9.5H4.75V19H7zM5.88 5a1.31 1.31 0 1 0 0 2.62 1.31 1.31 0 0 0 0-2.62zM9.5 9.5V19h2.25v-4.9c0-1.3.6-2.1 1.7-2.1 1 0 1.4.7 1.4 2V19h2.4v-5.6c0-2.7-1.3-4.1-3.4-4.1-1.1 0-1.9.5-2.25 1.15V9.5z"/>',
			true,
		),
	},
	{
		label: 'Email',
		href: `mailto:${CONTACT.email}`,
		svg: SVG('<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>'),
	},
];

const downloadIcon = SVG(
	'<path d="M14 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8z"/><path d="M14 2.5V8h5.5"/><path d="M12 11.5v6m-2.75-2.75L12 17.5l2.75-2.75"/>',
);
---

<div class="links">
	<a class="resume" href={CONTACT.resume}>
		<span class="icon" set:html={downloadIcon} />
		Resume
	</a>
	<ul class="icons">
		{
			icons.map(({ label, href, svg }) => (
				<li>
					<a class="icon-button" href={href} aria-label={label} title={label}>
						<span class="icon" set:html={svg} />
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
	}

	.icons {
		display: flex;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.icon :global(svg) {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
	}

	.resume {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4) var(--space-2) var(--space-3);
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-bg);
		font-weight: 600;
		text-decoration: none;
		box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--color-accent) 80%, transparent);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}

	.resume:hover {
		color: var(--color-bg);
		background: var(--color-accent-hover);
		box-shadow: 0 10px 28px -8px color-mix(in srgb, var(--color-accent) 90%, transparent);
	}

	.icon-button {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		color: var(--color-text-muted);
		background: color-mix(in srgb, var(--color-surface) 80%, transparent);
		border: 1px solid var(--color-border);
		backdrop-filter: blur(6px);
		transition:
			transform 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.icon-button:hover,
	.icon-button:focus-visible {
		color: var(--color-accent);
		border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
		box-shadow: 0 0 18px -4px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) {
		.resume:hover,
		.icon-button:hover {
			transform: translateY(-2px);
		}
	}
</style>
