---
/**
 * Sticky site header. Every link targets a section of the one-page home ("/#id"), so the same
 * links jump within the home page and lead back to it from a case study. There is no
 * active-section highlight: that would need client-side JS to track scrolling.
 */
const links = [
	{ href: '/#about', label: 'About' },
	{ href: '/#experience', label: 'Experience' },
	{ href: '/#education', label: 'Education' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/#contact', label: 'Contact' },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="container inner">
		<a class="site-name" href="/">Aaron Yalong</a>
		<nav aria-label="Main">
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	/* Fixed height (--header-h, in global.css) so sections can offset anchor jumps by it. */
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		height: var(--header-h);
	}

	.site-name {
		flex: none;
		font-weight: 650;
		color: var(--color-text);
		text-decoration: none;
	}

	ul {
		display: flex;
		gap: var(--space-6);
		padding: 0;
		list-style: none;
	}

	nav a {
		color: var(--color-text-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--color-text);
	}

	/* Narrow screens: name on one row, links on a second row that scrolls sideways if it
	   doesn't fit, rather than wrapping and growing the header. */
	@media (max-width: 47.99rem) {
		.inner {
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
			gap: var(--space-1);
		}

		ul {
			gap: var(--space-4);
			/* Room for focus outlines, which the scroll container would otherwise clip. */
			padding: 3px;
			margin: -3px;
			overflow-x: auto;
			scrollbar-width: none;
			font-size: var(--text-sm);
		}
	}

	.skip-link {
		position: absolute;
		z-index: 20;
		top: var(--space-2);
		left: var(--space-2);
		padding: var(--space-2) var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}
</style>
