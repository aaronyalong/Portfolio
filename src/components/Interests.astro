---
/**
 * "Outside of work": the interests as a compact row of pills (2×2 on phones), all visible at
 * once. Sits in the home page's dark photo band, so it uses the band's (dark) colours.
 *
 * An interest with `href` is a link: the whole pill is clickable, opens in the same tab,
 * gets a visible focus ring, and shows a small ↗ when it leads to another site. Without
 * `href` it is a plain pill.
 *
 * The icons have small CSS animations (blinking cursor, pulsing agent nodes, lines drawn on
 * hover), all off under prefers-reduced-motion.
 */
interface Interest {
	label: string;
	/** Inline SVG markup (24×24 viewBox, stroke = currentColor). */
	icon: string;
	/** Where the pill links to, e.g. a travel site for Hiking. Omit for a plain pill. */
	href?: string;
}

const SVG = (body: string) =>
	`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

const interests: Interest[] = [
	{
		label: 'Linux',
		icon: SVG(
			`<rect x="2.5" y="4" width="19" height="16" rx="2.5"/>` +
				`<polyline points="6.5 9.5 9.5 12 6.5 14.5"/>` +
				`<line class="cursor" x1="11.5" y1="15" x2="16" y2="15"/>`,
		),
	},
	{
		label: 'Hiking',
		icon: SVG(
			`<path d="M2.5 19.5 9 8.5l3.5 6 2.5-3.5 6.5 8.5z"/>` +
				`<path class="trail" pathLength="1" d="M6 19.5c1.5-1.5 1-3 2.5-4.5s2.5-1.5 3-3"/>` +
				`<circle cx="18" cy="5.5" r="1.75"/>`,
		),
	},
	{
		label: 'AI agents',
		icon: SVG(
			`<path d="M12 12 5.5 6M12 12l6.5-6M12 12l-6.5 6M12 12l6.5 6"/>` +
				`<circle class="agent-node an0" cx="12" cy="12" r="2.25"/>` +
				`<circle class="agent-node an1" cx="5" cy="5.5" r="1.75"/>` +
				`<circle class="agent-node an2" cx="19" cy="5.5" r="1.75"/>` +
				`<circle class="agent-node an3" cx="19" cy="18.5" r="1.75"/>` +
				`<circle class="agent-node an4" cx="5" cy="18.5" r="1.75"/>`,
		),
	},
	{
		label: 'Stocks',
		icon: SVG(
			`<path d="M3.5 3.5v17h17"/>` +
				`<polyline class="line" pathLength="1" points="6.5 15.5 10 11.5 13 13.5 19 6.5"/>` +
				`<polyline points="15.5 6.5 19 6.5 19 10"/>`,
		),
	},
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ul class="pills">
	{
		interests.map(({ label, icon, href }) => {
			const Tag = href ? 'a' : 'span';
			return (
				<li>
					<Tag class="pill" href={href} data-spotlight>
						<span class="icon" set:html={icon} />
						<span class="label">{label}</span>
						{href && isExternal(href) && (
							<>
								<span class="ext" aria-hidden="true">
									↗
								</span>
								<span class="visually-hidden"> (another site)</span>
							</>
						)}
					</Tag>
				</li>
			);
		})
	}
</ul>

<style>
	/* Phones: a 2×2 grid. Wider: one row that wraps if it must. */
	.pills {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.pills {
			display: flex;
			flex-wrap: wrap;
		}
	}

	.pill {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		height: 100%;
		padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
		/* background-color, not the shorthand, so the cursor spotlight can paint over it. */
		background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);
		backdrop-filter: blur(8px);
		border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
		border-radius: 999px;
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Linked pills: accent border and glow on hover, and a ring on keyboard focus. */
	a.pill:hover {
		color: var(--color-text);
		border-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
		box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	a.pill:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 999px;
	}

	.icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 16%, transparent);
	}

	.icon :global(svg) {
		width: 1.4rem;
		height: 1.4rem;
	}

	.label {
		font-weight: 600;
		white-space: nowrap;
	}

	.ext {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	/* Static state of the hover-drawn lines. */
	.pill :global(.line) {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	.pill :global(.trail) {
		stroke-width: 1.25;
		stroke-dasharray: 0.08 0.06;
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.pill :global(.cursor) {
			animation: blink 1.1s steps(1) infinite;
		}

		.pill :global(.agent-node) {
			transform-box: fill-box;
			transform-origin: center;
			animation: pulse 2.4s ease-in-out infinite;
		}
		.pill :global(.an1) { animation-delay: 0.3s; }
		.pill :global(.an2) { animation-delay: 0.6s; }
		.pill :global(.an3) { animation-delay: 0.9s; }
		.pill :global(.an4) { animation-delay: 1.2s; }

		.pill:hover :global(.line) {
			animation: draw 0.9s ease-out;
		}

		.pill:hover :global(.trail) {
			animation: march 1.2s linear infinite;
		}
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@keyframes pulse {
		0%,
		60%,
		100% {
			transform: scale(1);
			fill: transparent;
		}
		30% {
			transform: scale(1.25);
			fill: currentColor;
		}
	}

	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
	}

	@keyframes march {
		to {
			stroke-dashoffset: -0.14;
		}
	}
</style>
