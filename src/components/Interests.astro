---
/**
 * "Outside of work": each interest hangs off the home page's graph rail on its own branch.
 * While scrolling, the junction dot appears, the branch grows out from the rail, and the
 * icon and label slide in along it. Expects `--rail` (the rail's x offset, relative to the
 * content's left edge) from an ancestor; see `.graph` in src/pages/index.astro.
 *
 * All motion is CSS and switches off under prefers-reduced-motion; browsers without scroll
 * timelines show the finished branches.
 */
interface Interest {
	label: string;
	/** Inline SVG markup (24×24 viewBox, stroke = currentColor). */
	icon: string;
}

const SVG = (body: string) =>
	`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

const interests: Interest[] = [
	{
		label: 'Linux',
		icon: SVG(
			`<rect x="2.5" y="4" width="19" height="16" rx="2.5"/>` +
				`<polyline points="6.5 9.5 9.5 12 6.5 14.5"/>` +
				`<line class="cursor" x1="11.5" y1="15" x2="16" y2="15"/>`,
		),
	},
	{
		label: 'Hiking',
		icon: SVG(
			`<path d="M2.5 19.5 9 8.5l3.5 6 2.5-3.5 6.5 8.5z"/>` +
				`<path class="trail" pathLength="1" d="M6 19.5c1.5-1.5 1-3 2.5-4.5s2.5-1.5 3-3"/>` +
				`<circle cx="18" cy="5.5" r="1.75"/>`,
		),
	},
	{
		label: 'AI agents',
		icon: SVG(
			`<path d="M12 12 5.5 6M12 12l6.5-6M12 12l-6.5 6M12 12l6.5 6"/>` +
				`<circle class="agent-node an0" cx="12" cy="12" r="2.25"/>` +
				`<circle class="agent-node an1" cx="5" cy="5.5" r="1.75"/>` +
				`<circle class="agent-node an2" cx="19" cy="5.5" r="1.75"/>` +
				`<circle class="agent-node an3" cx="19" cy="18.5" r="1.75"/>` +
				`<circle class="agent-node an4" cx="5" cy="18.5" r="1.75"/>`,
		),
	},
	{
		label: 'Stocks',
		icon: SVG(
			`<path d="M3.5 3.5v17h17"/>` +
				`<polyline class="line" pathLength="1" points="6.5 15.5 10 11.5 13 13.5 19 6.5"/>` +
				`<polyline points="15.5 6.5 19 6.5 19 10"/>`,
		),
	},
];
---

<ul class="tree">
	{
		interests.map(({ label, icon }) => (
			<li class="branch">
				<span class="pill">
					<span class="icon" set:html={icon} />
					<span class="label">{label}</span>
				</span>
			</li>
		))
	}
</ul>

<style>
	.tree {
		display: grid;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	/* The list item holds the branch line and junction dot; the pill inside it slides in. */
	.branch {
		position: relative;
		width: fit-content;
		view-timeline: --branch block;
	}

	.pill {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-width: 13rem;
		padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* The branch: from the rail to the item. */
	.branch::before {
		content: '';
		position: absolute;
		top: calc(50% - 1px);
		left: var(--rail);
		width: calc(-1 * var(--rail));
		height: 2px;
		background: color-mix(in srgb, var(--color-accent) 60%, transparent);
		transform-origin: left;
	}

	/* The junction dot on the rail. */
	.branch::after {
		content: '';
		position: absolute;
		top: calc(50% - 4px);
		left: calc(var(--rail) - 4px);
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.branch:hover .pill {
		border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
		box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	.icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.icon :global(svg) {
		width: 1.75rem;
		height: 1.75rem;
	}

	.label {
		font-weight: 600;
	}

	/* Static state of the hover-drawn lines. */
	.branch :global(.line) {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	.branch :global(.trail) {
		stroke-width: 1.25;
		stroke-dasharray: 0.08 0.06;
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Scroll: junction dot, then branch, then icon and label slide in along it. */
		@supports (animation-timeline: view()) {
			/* Longhands only: an `animation` shorthand next to `animation-timeline` gets merged by
			   the CSS minifier into one invalid declaration, which browsers then drop. */
			.branch::after,
			.branch::before,
			.pill {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --branch;
			}

			.branch::after {
				animation-name: pop;
				animation-range: entry 0% cover 12%;
			}

			.branch::before {
				animation-name: grow-x;
				animation-range: cover 8% cover 24%;
			}

			.pill {
				animation-name: slide-in;
				animation-range: cover 18% cover 34%;
			}
		}

		/* Icons: blinking cursor, pulsing agent nodes, lines drawn on hover. */
		.branch :global(.cursor) {
			animation: blink 1.1s steps(1) infinite;
		}

		.branch :global(.agent-node) {
			transform-box: fill-box;
			transform-origin: center;
			animation: pulse 2.4s ease-in-out infinite;
		}
		.branch :global(.an1) { animation-delay: 0.3s; }
		.branch :global(.an2) { animation-delay: 0.6s; }
		.branch :global(.an3) { animation-delay: 0.9s; }
		.branch :global(.an4) { animation-delay: 1.2s; }

		.branch:hover :global(.line) {
			animation: draw 0.9s ease-out;
		}

		.branch:hover :global(.trail) {
			animation: march 1.2s linear infinite;
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0);
		}
	}

	@keyframes grow-x {
		from {
			transform: scaleX(0);
		}
	}

	@keyframes slide-in {
		from {
			opacity: 0;
			transform: translateX(-16px);
		}
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@keyframes pulse {
		0%,
		60%,
		100% {
			transform: scale(1);
			fill: transparent;
		}
		30% {
			transform: scale(1.25);
			fill: currentColor;
		}
	}

	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
	}

	@keyframes march {
		to {
			stroke-dashoffset: -0.14;
		}
	}
</style>
