---
/**
 * Primary pill button linking to the resume PDF. Renders nothing when the PDF is missing
 * (see src/lib/resume.ts).
 */
import { RESUME_HREF } from '../lib/resume';

interface Props {
	label?: string;
	/** Ask the browser to save the file instead of opening it. */
	download?: boolean;
}

const { label = 'Resume', download = false } = Astro.props;

const icon =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8z"/><path d="M14 2.5V8h5.5"/><path d="M12 11.5v6m-2.75-2.75L12 17.5l2.75-2.75"/></svg>';
---

{
	RESUME_HREF && (
		<a class="resume" href={RESUME_HREF} download={download || undefined}>
			<span class="icon" set:html={icon} />
			{label}
		</a>
	)
}

<style>
	.resume {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4) var(--space-2) var(--space-3);
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-bg);
		font-weight: 600;
		text-decoration: none;
		box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--color-accent) 80%, transparent);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}

	.resume:hover {
		color: var(--color-bg);
		background: var(--color-accent-hover);
		box-shadow: 0 10px 28px -8px color-mix(in srgb, var(--color-accent) 90%, transparent);
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) {
		.resume:hover {
			transform: translateY(-2px);
		}
	}

	.icon :global(svg) {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
	}
</style>
