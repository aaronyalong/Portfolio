---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<p>© {year} Aaron Yalong</p>
		<ul>
			<li><a href="https://github.com/aaronyalong">GitHub</a></li>
			<!-- TODO(Aaron): add LinkedIn profile URL -->
			<li class="todo">TODO: LinkedIn</li>
			<!-- TODO(Aaron): add public contact email -->
			<li class="todo">TODO: Email</li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2) var(--space-6);
		padding-block: var(--space-6);
	}

	ul {
		display: flex;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.todo {
		font-family: var(--font-mono);
	}
</style>
