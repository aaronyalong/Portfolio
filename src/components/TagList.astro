---
/** A row of small outlined tags, e.g. a tech stack. Renders nothing for an empty list. */
interface Props {
	items: string[];
	/** Accessible name for the list. */
	label?: string;
	/** Show at most this many, then a "+N" tag for the rest. */
	max?: number;
}

const { items, label = 'Tech stack', max } = Astro.props;
const shown = max ? items.slice(0, max) : items;
const rest = items.length - shown.length;
---

{
	items.length > 0 && (
		<ul class="tags" aria-label={label}>
			{shown.map((item) => <li>{item}</li>)}
			{rest > 0 && (
				<li class="rest">
					<span aria-hidden="true">+{rest}</span>
					<span class="visually-hidden">and {rest} more</span>
				</li>
			)}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0 var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	.tags .rest {
		border-style: dashed;
	}
</style>
