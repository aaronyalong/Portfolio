---
/**
 * Vertical timeline: a rail on the left with one marker per entry: the entry's logo, or a dot
 * when it has none. The first current entry (the list arrives sorted, most recent first) is
 * the "lead": accent dot, or an accent ring around its logo. Other current entries get a
 * solid muted dot or a muted ring; past entries a hollow dot or a hairline border.
 * Markers and rail are decorative and hidden from assistive tech (the org name is beside
 * each logo, so the logo's alt is empty).
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import {
	formatYearMonth,
	isCurrent,
	isExpected,
	isTodo,
	primaryCurrent,
	type TimelineItem,
} from '../lib/content';

interface Props {
	items: TimelineItem[];
}

const { items } = Astro.props;

const TYPE_LABELS = {
	'full-time': 'Full-time',
	'part-time': 'Part-time',
	contract: 'Contract',
	internship: 'Internship',
} as const;

const leadId = primaryCurrent(items)?.id;
// Logos need a wider marker column than dots; the whole timeline uses the wider one.
const hasLogos = items.some((item) => item.data.logo);

const entries = await Promise.all(
	items.map(async (item) => {
		const { start, end, type } = item.data;
		const current = isCurrent(item);
		const isDegree = item.collection === 'education';
		// Related projects that have a page to link to.
		const projects = (await Promise.all(item.data.projects.map((ref) => getEntry(ref)))).filter(
			(project) => project !== undefined && project.data.caseStudy && !project.data.draft,
		);
		return {
			item,
			state: item.id === leadId ? 'lead' : current ? 'current' : 'past',
			// A degree in progress already reads "Expected <date>", so it needs no tag.
			showCurrentTag: current && !isDegree,
			typeLabel: type?.map((t) => TYPE_LABELS[t]).join(' · '),
			start,
			end,
			// Degrees may give only the end date; a role with no start date is a TODO.
			startTodo: !start && !isDegree,
			expected: isExpected(item),
			projects,
		};
	}),
);
---

<ol class:list={['timeline', { 'with-logos': hasLogos }]}>
	{
		entries.map(({ item, state, showCurrentTag, typeLabel, start, end, startTodo, expected, projects }) => (
			<li class="entry" data-state={state}>
				{item.data.logo ? (
					<span class="marker logo" aria-hidden="true">
						<Image src={item.data.logo} alt="" width={80} height={80} />
					</span>
				) : (
					<span class="marker dot" aria-hidden="true" />
				)}
				<div class="head">
					<h3>
						<span class:list={{ todo: isTodo(item.data.title) }}>{item.data.title}</span>{' '}
						<span class="org">
							<span class="sep" aria-hidden="true">· </span>
							{item.data.org}
						</span>
					</h3>
					<p class="when">
						{start && <time datetime={start}>{formatYearMonth(start)}</time>}
						{startTodo && <span class="todo">TODO: start</span>}
						{(start || startTodo) && ' – '}
						{expected && 'Expected '}
						{end === 'present' ? (
							'Present'
						) : end ? (
							<time datetime={end}>{formatYearMonth(end)}</time>
						) : (
							<span class="todo">TODO: end</span>
						)}
					</p>
				</div>
				{(showCurrentTag || typeLabel) && (
					<p class="meta">
						{showCurrentTag && <span class="current">Current</span>}
						{typeLabel}
					</p>
				)}
				{item.data.summary && <p class="summary">{item.data.summary}</p>}
				{item.data.bullets.length > 0 && (
					<ul class="bullets">
						{item.data.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				)}
				<TagList items={item.data.stack} />
				{item.data.coursework.length > 0 && (
					<p class="detail">
						<span class="label">Relevant coursework:</span> {item.data.coursework.join(' · ')}
					</p>
				)}
				{projects.length > 0 && (
					<p class="detail">
						<span class="label">Projects:</span>{' '}
						{projects.map((project, i) => (
							<>
								{i > 0 && ' · '}
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</>
						))}
					</p>
				)}
				{item.data.links.length > 0 && (
					<p class="links">
						{item.data.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</p>
				)}
			</li>
		))
	}
</ol>

<style>
	.timeline {
		/* Geometry: each marker is centred on the first line of its title, and horizontally in a
		   marker column (--col) that the rail runs down the middle of. */
		--dot: 0.75rem;
		--logo: 2.5rem;
		--col: var(--dot);
		--indent: var(--space-8);
		--gap: var(--space-8);
		--title-line: calc(var(--text-lg) * 1.25);
		--rail: color-mix(in srgb, var(--color-text-muted) 35%, transparent);

		display: grid;
		gap: var(--gap);
		padding: 0;
		list-style: none;
		/* Entries lay out by the timeline's own width, not the viewport's, so a timeline in a
		   narrow column stacks its dates even on a wide screen. */
		container: timeline / inline-size;
	}

	.entry {
		position: relative;
		display: grid;
		gap: var(--space-2);
		padding-left: var(--indent);
	}

	.with-logos {
		--col: var(--logo);
		--indent: calc(var(--logo) + var(--space-4));
	}

	/* Narrow timelines (phones, or a narrow column): slightly smaller logos. */
	@container timeline (max-width: 24rem) {
		.with-logos .entry {
			--logo: 2.25rem;
			--col: var(--logo);
			--indent: calc(var(--logo) + var(--space-3));
		}
	}

	/* ---------- Marker: a dot or a logo, above the rail ---------- */
	.marker {
		--size: var(--dot);
		position: absolute;
		z-index: 1;
		top: calc((var(--title-line) - var(--size)) / 2);
		left: calc((var(--col) - var(--size)) / 2);
		width: var(--size);
		height: var(--size);
	}

	.dot {
		border-radius: 50%;
		/* Past: hollow (filled with the page colour so the rail doesn't show through). */
		background: var(--color-bg);
		border: 2px solid var(--color-text-muted);
	}

	[data-state='current'] .dot {
		background: var(--color-text-muted);
	}

	[data-state='lead'] .dot {
		background: var(--color-accent);
		border-color: var(--color-accent);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-accent) 22%, transparent),
			0 0 14px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}

	/* Logos bring their own background; they sit in a rounded tile. Past: a hairline border.
	   Other current roles: a muted ring. The lead: an accent ring with a soft glow. */
	.logo {
		--size: var(--logo);
		overflow: hidden;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 0 0 1px var(--color-border);
	}

	.logo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	[data-state='current'] .logo {
		box-shadow:
			0 0 0 2px var(--color-bg),
			0 0 0 4px var(--color-text-muted);
	}

	[data-state='lead'] .logo {
		box-shadow:
			0 0 0 2px var(--color-bg),
			0 0 0 4px var(--color-accent),
			0 0 18px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	/* ---------- Rail: from each marker's centre to the next one's, behind the markers ---------- */
	.entry:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(var(--title-line) / 2);
		bottom: calc(-1 * (var(--gap) + var(--title-line) / 2));
		left: calc(var(--col) / 2 - 1px);
		width: 2px;
		border-radius: 2px;
		background: var(--rail);
	}

	.entry[data-state='lead']:not(:last-child)::after {
		background: linear-gradient(to bottom, var(--color-accent), var(--rail));
	}

	/* ---------- Content ---------- */
	.head {
		display: grid;
		gap: 0 var(--space-4);
	}

	@container timeline (min-width: 32rem) {
		/* Title left, dates right-aligned on the same line. */
		.head {
			grid-template-columns: 1fr auto;
			align-items: baseline;
		}
	}

	h3 {
		font-size: var(--text-lg);
	}

	.org {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	/* Narrow timelines: the org gets its own line, so the separator would start it. */
	@container timeline (max-width: 31.99rem) {
		.org {
			display: block;
		}

		.sep {
			display: none;
		}
	}

	.when,
	.meta {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.when {
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	.current {
		padding: 0 var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	[data-state='lead'] .current {
		border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		color: var(--color-accent);
	}

	.summary,
	.bullets {
		max-width: var(--prose-width);
	}

	.bullets {
		display: grid;
		gap: var(--space-1);
		padding-left: var(--space-4);
	}

	.bullets li::marker {
		color: var(--color-text-muted);
	}

	.detail,
	.links {
		font-size: var(--text-sm);
	}

	.label {
		color: var(--color-text-muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
</style>
