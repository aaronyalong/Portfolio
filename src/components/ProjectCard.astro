---
import ProjectMeta from './ProjectMeta.astro';
import type { Project } from '../lib/content';

interface Props {
	project: Project;
	/** Heading level, so the card fits the page outline. */
	as?: 'h2' | 'h3';
}

const { project, as: Heading = 'h3' } = Astro.props;
const { title, summary, repo, play, caseStudy } = project.data;
---

<article class="card">
	<Heading class="title">
		{caseStudy ? <a href={`/projects/${project.id}/`}>{title}</a> : title}
	</Heading>
	<p>{summary}</p>
	<ProjectMeta project={project} />
	{
		(repo || play) && (
			<p class="links">
				{repo && <a href={repo}>Repository</a>}
				{play && <a href={play}>Play in browser</a>}
			</p>
		)
	}
</article>

<style>
	.card {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.title {
		font-size: var(--text-lg);
	}

	.links {
		display: flex;
		gap: var(--space-4);
		font-size: var(--text-sm);
	}
</style>
