---
import ProjectMeta from './ProjectMeta.astro';
import type { Project } from '../lib/content';

interface Props {
	project: Project;
	/** Heading level, so the card fits the page outline. */
	as?: 'h2' | 'h3';
}

const { project, as: Heading = 'h3' } = Astro.props;
const { title, summary, repo } = project.data;
---

<article class="card">
	<Heading class="title"><a href={`/projects/${project.id}/`}>{title}</a></Heading>
	<p>{summary}</p>
	<ProjectMeta project={project} />
	{repo && <p class="links"><a href={repo}>Repository</a></p>}
</article>

<style>
	.card {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.title {
		font-size: var(--text-lg);
	}

	.links {
		font-size: var(--text-sm);
	}
</style>
